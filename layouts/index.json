{{- $sections := slice "research" "reading" "policy" "thoughts" "posts" -}}
{{- $realPages := partial "real-pages.html" site.RegularPages -}}
{{- $pages := where $realPages "Section" "in" $sections -}}
{{- $pages = sort $pages "Date" "desc" -}}
[
{{- range $i, $p := $pages -}}
{{- if $i }},{{ end }}
{
  "title":   {{ $p.Title | jsonify }},
  "url":     {{ $p.Permalink | jsonify }},
  "section": {{ $p.Section | jsonify }},
  "date":    {{ $p.Date.Format "2006-01-02" | jsonify }},
  "tags":    {{ $p.Params.tags | jsonify }},
  "fields":  {{ $p.Params.fields | jsonify }},
  "status":  {{ $p.Params.status | jsonify }},
  "summary": {{ $p.Summary | plainify | jsonify }}
}
{{- end }}
]
